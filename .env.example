# Copie para .env e ajuste. .env não vai para o repositorio.

# Obrigatorio quando DJANGO_DEBUG=0. Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# 1 = desenvolvimento, 0 = producao
DJANGO_DEBUG=1

# Hosts separados por virgula. Em producao, o dominio real da hospedagem.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Origens confiaveis para CSRF (obrigatorio em HTTPS). Ex.: https://meu-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Caminho do arquivo SQLite. Em hospedagem com disco persistente, aponte para o disco.
DJANGO_SQLITE_PATH=

# Se preenchido, tem prioridade sobre o SQLite (ex.: postgres://user:senha@host:5432/base).
DATABASE_URL=
