# Copie para .env e ajuste. .env não vai para o repositorio.

# Obrigatorio quando DJANGO_DEBUG=0. Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# 1 = desenvolvimento, 0 = producao
DJANGO_DEBUG=1

# Hosts separados por virgula. Em producao, o dominio real da hospedagem.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Origens confiaveis para CSRF (obrigatorio em HTTPS). Ex.: https://meu-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Caminho do arquivo SQLite. Usado so em desenvolvimento; em producao quem manda
# e a DATABASE_URL abaixo.
DJANGO_SQLITE_PATH=

# Postgres da Neon. Se preenchida, tem prioridade sobre o SQLite. Copie a string
# do painel da Neon, com o sslmode que ela ja traz. Em producao esta variavel
# nao e opcional: sem ela o app cai no SQLite do disco efemero da hospedagem e
# perde os dados a cada deploy.
# Formato: postgresql://usuario:senha@ep-algo-123.sa-east-1.aws.neon.tech/base?sslmode=require
DATABASE_URL=

# Escotilha so para exercitar a configuracao de producao na maquina local sobre
# SQLite. Nunca definir na hospedagem: existe justamente para que producao sem
# DATABASE_URL falhe em vez de perder dados em silencio.
DJANGO_ALLOW_SQLITE_IN_PRODUCTION=
